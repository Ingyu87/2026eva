# Admin
ADMIN_PASSWORD=백인규
SESSION_SECRET=replace-with-a-long-random-string

# Firebase Admin SDK
# Option A: one-line service account JSON
FIREBASE_SERVICE_ACCOUNT_JSON={"project_id":"...","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}

# Option B: separate Firebase values
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google OAuth / Forms API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 로컬: 비워 두면 브라우저 주소(localhost vs 127.0.0.1)에 맞춰 /api/google/callback 이 잡힙니다.
# 고정할 때만 설정. Google Cloud 콘솔「승인된 리디렉션 URI」에 동일 문자열을 등록하세요.
# GOOGLE_REDIRECT_URI=
# 배포: 반드시 프로덕션 URL과 일치
# GOOGLE_REDIRECT_URI=https://your-app.vercel.app/api/google/callback
