{
  "name": "school-evaluation-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "guide:capture": "node scripts/capture-guide.mjs",
    "verify:concurrent": "bash scripts/verify-concurrent-editing.sh",
    "verify:results": "bash scripts/verify-results.sh",
    "verify:ai": "bash scripts/verify-ai-analysis.sh",
    "verify:indicator": "bash scripts/verify-indicator-xlsx.sh",
    "verify:design": "node scripts/verify-design-rules.mjs",
    "verify:bank": "node scripts/verify-question-bank.mjs",
    "verify:scoring": "node scripts/verify-scoring.mjs",
    "verify": "npm run typecheck && npm run verify:bank && npm run verify:design && npm run verify:scoring"
  },
  "dependencies": {
    "docx": "^9.5.1",
    "exceljs": "^4.4.0",
    "firebase-admin": "^13.0.2",
    "next": "^15.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "puppeteer-core": "^25.11.0",
    "typescript": "^5.7.2"
  }
}
